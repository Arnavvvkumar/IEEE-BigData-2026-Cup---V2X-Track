+def expand_env_in_config(cfg):
+    """Expand ${VAR} (e.g. ${BDC_DATA}) in the string values of a config, so the yaml files can use one configurable data root."""
+    for key, val in list(cfg.items()):
+        if isinstance(val, str) and '$' in val:
+            cfg[key] = os.path.expandvars(val)
+        elif isinstance(val, dict):
+            expand_env_in_config(val)
+        elif isinstance(val, list):
+            cfg[key] = [os.path.expandvars(v) if isinstance(v, str) and '$' in v else v for v in val]
+            for v in cfg[key]:
+                if isinstance(v, dict):
+                    expand_env_in_config(v)
+    return cfg
+
